[Unit]
Description=inspobot — лента из открытых источников
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=inspobot
WorkingDirectory=/opt/inspobot
ExecStart=/opt/inspobot/.venv/bin/python -m inspobot.feed
EnvironmentFile=/opt/inspobot/.env
StandardOutput=journal
StandardError=journal
