# --- Telegram -------------------------------------------------------------
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=123456:AA...
# Куда слать подборку одному получателю. Свой id подскажет inspobot.doctor
TELEGRAM_CHAT_ID=123456789
# Для рассылки на несколько чатов — файл со списком, по одному id в строке.
# Если файл есть, TELEGRAM_CHAT_ID не используется.
INSPOBOT_CHATS=var/chats.txt

# --- Anthropic ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Нужен, только если ключ выпущен на уровне организации, а не внутри workspace
# ANTHROPIC_WORKSPACE_ID=
# По умолчанию claude-opus-5. Дешевле — claude-sonnet-5
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max
INSPOBOT_EFFORT=high
# Серверный фолбэк на случай отказа модели; выключается значением 0
ANTHROPIC_SERVER_FALLBACKS=1

# --- Mobbin ---------------------------------------------------------------
MOBBIN_MCP_URL=https://api.mobbin.com/mcp
# Заполняется автоматически после `python -m inspobot.auth_cli`
MOBBIN_TOKEN_FILE=var/mobbin_token.json
# Если токен уже есть — можно задать напрямую и не проходить OAuth
# MOBBIN_ACCESS_TOKEN=

# --- Расписание и объём ---------------------------------------------------
INSPOBOT_TZ=Europe/Moscow
INSPOBOT_HOUR=11
INSPOBOT_MINUTE=0
# Расписание на неделю настраивается командой `python -m inspobot.setup_cli`
INSPOBOT_PROFILE=var/profile.json
# document — исходные файлы: Telegram их не сжимает, мелкий текст читается.
# photo — сжатые картинки плиткой, зато компактнее в ленте.
INSPOBOT_IMAGE_MODE=document
# Кнопки «Топ-10» под шапкой подборки. Работают, только если запущена
# служба inspobot.listener — она принимает нажатия.
INSPOBOT_TOP_BUTTONS=1
INSPOBOT_DB=var/inspobot.sqlite3

# --- Лента из открытых источников (python -m inspobot.feed) ---------------
# Второй дайджест: экраны недели с Mobbin, сайты дня CSS Design Awards,
# кейсы студий, Behance, Dribbble, DProfile, Made on Tilda, Snapensnap.
# Ключ Anthropic ей не нужен: всё это источники публикуют машиночитаемо, а в
# Mobbin бот ходит напрямую по MCP. См. docs/SOURCES.md
#
# Правки источников поверх встроенного списка — без выката
# INSPOBOT_SOURCES=var/sources.json
# Свой список студий; заменяет config/studios.txt целиком
# INSPOBOT_STUDIOS=var/studios.txt
# photo — сжатые картинки плиткой (у ленты это обложки, сжатие им не вредит).
# document — исходные файлы
INSPOBOT_FEED_IMAGE_MODE=photo
# Заказывать снимок страницы, если у находки нет своей картинки
INSPOBOT_FEED_SHOTS=1
# Свой сервис снимков вместо mShots; {url} — место для адреса
# INSPOBOT_SHOT_URL=https://image.thum.io/get/width/1200/{url}
# Уважать robots.txt источников
INSPOBOT_FEED_ROBOTS=1
# Когда уходит лента. Раньше подборки: два письма в одну минуту читаются
# как одно длинное, и второе пролистывают.
INSPOBOT_FEED_HOUR=9
INSPOBOT_FEED_MINUTE=0
